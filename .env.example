# ============================================================
# PinHunt UK — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# For Replit: add these as Secrets (not .env) via the Secrets panel.
# ============================================================

# ── Supabase (Expo / mobile — EXPO_PUBLIC_ prefix required) ──────────────────
# Find these in: Supabase dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase (API server — server-side, no EXPO_PUBLIC_ prefix) ──────────────
# Same URL as above. Anon key is sufficient for the scan endpoint.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ── Supabase (import scripts ONLY — service role key bypasses RLS) ────────────
# WARNING: Never expose this key to the Expo client or any browser code.
# Find this in: Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── API server ────────────────────────────────────────────────────────────────
# Port the Express server listens on (Replit assigns this automatically)
PORT=3000
LOG_LEVEL=info
IMPORT_STALL_WARNING_MINUTES=30

# Public API host used by the Expo app outside Replit.
# Use an HTTPS URL reachable from the simulator or physical device.
EXPO_PUBLIC_DOMAIN=https://your-api-host.example.com

# ── Optional AI-assisted scan features ────────────────────────────────────────
# Supply an OpenAI-compatible endpoint and key when using these features locally.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://your-openai-compatible-endpoint.example.com
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-api-key

# ── Optional Google Cloud Vision integration ──────────────────────────────────
# Store the complete service-account JSON as a single environment-variable value.
GOOGLE_APPLICATION_CREDENTIALS_JSON=your-google-service-account-json

# ── Optional eBay integration ─────────────────────────────────────────────────
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_ENVIRONMENT=sandbox
EBAY_DELETION_ENDPOINT_URL=https://your-public-host.example.com/api/ebay/account-deletion
EBAY_DELETION_VERIFICATION_TOKEN=your-ebay-deletion-verification-token

# ── Optional artifact routing ─────────────────────────────────────────────────
# Keep "/" for ordinary local development.
BASE_PATH=/
NODE_ENV=development

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
