# ============================================================
# PinHunt UK — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# For Replit: add these as Secrets (not .env) via the Secrets panel.
# ============================================================

# ── Supabase (Expo / mobile — EXPO_PUBLIC_ prefix required) ──────────────────
# Find these in: Supabase dashboard → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase (API server — server-side, no EXPO_PUBLIC_ prefix) ──────────────
# Same URL as above. Anon key is sufficient for the scan endpoint.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# ── Supabase (import scripts ONLY — service role key bypasses RLS) ────────────
# WARNING: Never expose this key to the Expo client or any browser code.
# Find this in: Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── API server ────────────────────────────────────────────────────────────────
# Port the Express server listens on (Replit assigns this automatically)
PORT=3000

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-to-a-long-random-string
