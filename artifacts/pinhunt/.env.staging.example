# PinHunt app — STAGING. Copy to .env.staging (gitignored) and fill in.
# Start with: pnpm --filter @workspace/pinhunt run dev:staging
# Shell variables take precedence over .env, and --clear rebuilds the bundle,
# so the production .env is never mixed in.
#
# Staging Supabase project: Dashboard → Project Settings → API.
# Only the anon (public) key belongs here — never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<staging-anon-key>

# The API server started with `pnpm --filter @workspace/api-server run start:staging`.
# Simulator on this Mac: http://localhost:3000/api. Physical device: an HTTPS
# tunnel or your Mac's LAN IP (dev builds only; release builds need HTTPS).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api
