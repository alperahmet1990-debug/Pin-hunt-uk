 const MAX_IMAGES = 16;
 const MAX_IMAGE_BYTES = 4_000_000;
 
+// The review starts the moment a PR opens or changes, alongside CI. Reviewing
+// before CI has reported made QA fail PRs only for "CI still running", so wait
+// (up to CI_WAIT_MS) for the other checks on this head to finish first.
+const CI_WAIT_MS = 12 * 60_000;
+const CI_POLL_MS = 20_000;
+/** Check runs this workflow or the merge gate publish: never waited for. */
+export const OWN_CHECKS = ['Agent review', 'QA review', 'Security review', 'Merge gate', 'Merge gate sweep'];
+/** Checks CI always creates for a PR; missing ones count as not finished yet. */
+export const EXPECTED_CI_CHECKS = ['Typecheck and tests'];
+
+/** Names of the CI checks on a head that haven't finished (or haven't started). */
+export function pendingCiChecks(runs) {
+  const others = runs.filter(r => !OWN_CHECKS.includes(r.name));
+  const running = others.filter(r => r.status !== 'completed').map(r => r.name);
+  const missing = EXPECTED_CI_CHECKS.filter(name => !others.some(r => r.name === name));
+  return [...new Set([...running, ...missing])];
+}
+
+/** The head's check runs once CI has finished, or as they are at the deadline. */
+export async function waitForCi(fetchRuns, { waitMs = CI_WAIT_MS, pollMs = CI_POLL_MS, now = Date.now, sleep = ms => new Promise(r => setTimeout(r, ms)) } = {}) {
+  const deadline = now() + waitMs;
+  for (;;) {
+    const runs = await fetchRuns();
+    const pending = pendingCiChecks(runs);
+    if (pending.length === 0 || now() >= deadline) return runs;
+    console.log(`Waiting for CI before reviewing: ${pending.join(', ')}`);
+    await sleep(pollMs);
+  }
+}
