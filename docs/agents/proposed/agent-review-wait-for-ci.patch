+
+test('the review waits for CI to finish before reviewing', async () => {
+  const r = (name, status = 'completed') => ({ name, status, conclusion: status === 'completed' ? 'success' : null });
+  assert.deepEqual(review.pendingCiChecks([r('Agent review', 'in_progress'), r('QA review', 'in_progress')]), ['Typecheck and tests'], 'CI not started yet');
+  assert.deepEqual(review.pendingCiChecks([r('Typecheck and tests', 'in_progress'), r('Agent rules')]), ['Typecheck and tests']);
+  assert.deepEqual(review.pendingCiChecks([r('Typecheck and tests'), r('Agent rules'), r('Agent review', 'in_progress')]), [], 'own run ignored');
+
+  let t = 0;
+  const calls = [];
+  const states = [[r('Typecheck and tests', 'queued')], [r('Typecheck and tests', 'in_progress')], [r('Typecheck and tests')]];
+  const runs = await review.waitForCi(async () => { calls.push(t); return states[Math.min(calls.length - 1, 2)]; }, { waitMs: 600_000, pollMs: 20_000, now: () => t, sleep: async ms => { t += ms; } });
+  assert.equal(calls.length, 3);
+  assert.equal(runs[0].status, 'completed');
+
+  t = 0;
+  const stuck = await review.waitForCi(async () => [r('Typecheck and tests', 'in_progress')], { waitMs: 60_000, pollMs: 20_000, now: () => t, sleep: async ms => { t += ms; } });
+  assert.equal(stuck[0].status, 'in_progress', 'gives up at the deadline and reviews what it has');
+});
