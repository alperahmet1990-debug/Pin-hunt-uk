-- ============================================================
-- PROPOSED Migration 045: Catalogue research staging (DRAFT — NOT APPLIED)
--
-- Status: design proposal on the research branch. Deliberately NOT in
-- supabase/migrations/ and named *.sql.draft so nothing picks it up.
-- Needs maintainer approval as an L3 change (approved + l3-go), staging
-- first, then production, per docs/agents/OPERATING-MODEL.md §3.
--
-- Purely additive: three new tables, two helper functions, one trigger.
-- No existing table, column, policy or row is changed. The trigger only
-- blocks future silent repurposing of a pinhunt_id (see id-reuse report).
--
-- Reuses: is_app_creator() (040), is_admin() (002), catalogue_sources (037),
-- import_batches (011), pin_change_audit (021), pins / pin_sets.
-- Writes happen only through the API server (service role) behind
-- requireAppCreator, like catalogue-import and catalogue-validation.
-- ============================================================

-- ── 1. Research runs: one row per engine run loaded into staging ─────────────
create table if not exists catalogue_research_runs (
  id               uuid        primary key default gen_random_uuid(),
  engine_version   text        not null,
  git_commit       text        not null check (git_commit ~ '^[0-9a-f]{7,40}$'),
  packet_hashes    jsonb       not null default '[]'::jsonb,   -- sha256 of each evidence packet
  summary          jsonb       not null default '{}'::jsonb,   -- counts from the engine's Summary sheet
  status           text        not null default 'loaded'
                     check (status in ('loaded', 'in_review', 'closed')),
  loaded_by        uuid        references profiles(id) on delete set null,
  loaded_at        timestamptz not null default now()
);

-- ── 2. Candidates: one proposed pin or set per research_key per run ──────────
create table if not exists catalogue_candidates (
  id                   uuid        primary key default gen_random_uuid(),
  run_id               uuid        not null references catalogue_research_runs(id) on delete cascade,
  research_key         text        not null check (research_key ~ '^[a-z0-9-]+(/[a-z0-9-]+)*$' and length(research_key) <= 200),
  entity_type          text        not null check (entity_type in ('pin', 'set')),
  set_research_key     text,
  proposed             jsonb       not null,           -- Master Catalogue-shaped fields (values only)
  record_confidence    text        not null check (record_confidence in ('High', 'Medium', 'Low', 'Unverified')),
  engine_verified      boolean     not null default false,
  review_reasons       text[]      not null default '{}',
  warnings             text[]      not null default '{}',
  duplicate_status     text        not null default 'NEW',
  duplicate_pin_id     uuid        references pins(id) on delete set null,
  status               text        not null default 'researched'
                         check (status in ('researched', 'needs_direct_verification', 'direct_verified',
                                           'approved', 'rejected', 'needs_more_research', 'imported', 'superseded')),
  direct_verified_by   uuid        references profiles(id) on delete set null,
  direct_verified_at   timestamptz,
  decided_by           uuid        references profiles(id) on delete set null,
  decided_at           timestamptz,
  decision_notes       text        check (length(decision_notes) <= 2000),
  import_batch_id      uuid        references import_batches(id) on delete set null,
  imported_pin_id      uuid        references pins(id) on delete set null,
  created_at           timestamptz not null default now(),
  updated_at           timestamptz not null default now(),
  unique (run_id, research_key),
  -- An approval always records who verified the sources directly and who decided.
  constraint candidate_approval_is_attributed check (
    status not in ('approved', 'imported')
    or (direct_verified_by is not null and decided_by is not null and decided_at is not null)),
  -- A candidate can only be imported as a NEW pin; existing pins are enriched through
  -- audited field changes (pin_change_audit), never by overwriting the row.
  constraint candidate_import_creates_new_pin check (
    status <> 'imported' or (imported_pin_id is not null and imported_pin_id is distinct from duplicate_pin_id))
);
create index if not exists catalogue_candidates_status_idx on catalogue_candidates (status, record_confidence);
create index if not exists catalogue_candidates_set_idx on catalogue_candidates (run_id, set_research_key);

-- ── 3. Evidence: one row per claim (field × source), immutable once loaded ───
create table if not exists catalogue_evidence (
  id             uuid        primary key default gen_random_uuid(),
  candidate_id   uuid        not null references catalogue_candidates(id) on delete cascade,
  field          text        not null check (field ~ '^[a-z_]{2,40}$'),
  value          jsonb       not null check (length(value::text) <= 600),
  source_url     text        check (source_url ~ '^https?://' and length(source_url) <= 2000),
  publisher      text        check (length(publisher) <= 200),
  source_class   text        not null check (source_class in ('official', 'news', 'fan', 'unclassified', 'physical', 'none')),
  method         text        not null check (method in ('page_fetch', 'search_snippet', 'physical_pin', 'editorial',
                                                        'legacy_record', 'human_direct_check')),
  note           text        check (length(note) <= 240),
  claim_ref      text,                                  -- engine claim_id, for traceability to the packet
  checked_by     uuid        references profiles(id) on delete set null,  -- set for human_direct_check
  created_at     timestamptz not null default now(),
  -- Excluded databases can never enter staging, whatever code writes the row.
  constraint evidence_not_excluded_source check (
    source_url is null or source_url !~* '^https?://([a-z0-9-]+\.)*(pinandpop|pinpics|pintradingdb)\.com(/|$)'),
  constraint evidence_human_check_attributed check (method <> 'human_direct_check' or checked_by is not null)
);
create index if not exists catalogue_evidence_candidate_idx on catalogue_evidence (candidate_id, field);

-- ── 4. RLS: App Creator reads/decides through the API; admins read; nobody else ─
alter table catalogue_research_runs enable row level security;
alter table catalogue_candidates    enable row level security;
alter table catalogue_evidence      enable row level security;

drop policy if exists catalogue_research_runs_read on catalogue_research_runs;
create policy catalogue_research_runs_read on catalogue_research_runs for select using (is_admin());
drop policy if exists catalogue_candidates_read on catalogue_candidates;
create policy catalogue_candidates_read on catalogue_candidates for select using (is_admin());
drop policy if exists catalogue_evidence_read on catalogue_evidence;
create policy catalogue_evidence_read on catalogue_evidence for select using (is_admin());
-- No insert/update/delete policies: writes go through the API server (service role)
-- behind requireAppCreator, matching 041. Evidence rows are append-only by convention;
-- the API exposes no update/delete route for them.

-- ── 5. Safe pinhunt_id minting (replaces max()+1 in importers) ───────────────
create sequence if not exists pinhunt_id_seq;
-- Seed it above the current maximum once, at apply time:
--   select setval('pinhunt_id_seq', (select coalesce(max(substring(pinhunt_id from 6)::bigint), 0) from pins));
create or replace function next_pinhunt_id() returns text
language sql volatile security definer set search_path = public as $$
  select 'PHUK-' || lpad(nextval('pinhunt_id_seq')::text, 8, '0');
$$;
revoke all on function next_pinhunt_id() from public, anon, authenticated;

-- ── 6. Identity guard: a pinhunt_id can never silently become a different pin ─
-- Blocks an UPDATE that changes the title AND the main character in one go
-- (what the July import did to 86 rows) unless the transaction has opted in
-- via set_config('pinhunt.allow_identity_change', 'on', true), which only the
-- audited admin correction path should do (and must write pin_change_audit).
create or replace function guard_pin_identity() returns trigger
language plpgsql as $$
begin
  if new.pinhunt_id is distinct from old.pinhunt_id then
    raise exception 'pinhunt_id is immutable';
  end if;
  if lower(coalesce(new.title, '')) is distinct from lower(coalesce(old.title, ''))
     and lower(coalesce(new.main_character, '')) is distinct from lower(coalesce(old.main_character, ''))
     and coalesce(current_setting('pinhunt.allow_identity_change', true), 'off') <> 'on' then
    raise exception 'identity change blocked for % (title and main character both changed); mint a new pin instead', old.pinhunt_id;
  end if;
  return new;
end $$;
drop trigger if exists pins_identity_guard on pins;
create trigger pins_identity_guard before update on pins
  for each row execute function guard_pin_identity();

-- ── Rollback (run in this order) ─────────────────────────────────────────────
-- drop trigger if exists pins_identity_guard on pins;
-- drop function if exists guard_pin_identity();
-- drop function if exists next_pinhunt_id();
-- drop sequence if exists pinhunt_id_seq;
-- drop table if exists catalogue_evidence;
-- drop table if exists catalogue_candidates;
-- drop table if exists catalogue_research_runs;
